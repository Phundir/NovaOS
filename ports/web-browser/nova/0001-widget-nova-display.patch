+namespace mozilla {
+namespace widget {
+
+static const unsigned long NOVA_IOCTL_CREATE = 0x4E01;
+static const unsigned long NOVA_IOCTL_PRESENT = 0x4E02;
+static const unsigned long NOVA_IOCTL_TITLE = 0x4E03;
+static const unsigned long NOVA_IOCTL_CURSOR = 0x4E04;
+
+static const char kDevice[] = "/dev/nova-gui";
+
+// Displays by widget, for the compositor thread, which knows its widget
+// but must not touch it. The same lock guards the popup lists: composing
+// reads them on the compositor thread, the main thread changes them.
+static StaticMutex sLock MOZ_UNANNOTATED;
+static const int kMaxDisplays = 64;
+static NovaDisplay* sDisplays[kMaxDisplays];
+static const void* sKeys[kMaxDisplays];
+
+bool NovaDisplay::Enabled() {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char* flag = getenv("NOVA_DISPLAY");
+    enabled = flag && flag[0] == '1' && access(kDevice, F_OK) == 0;
+  }
+  return enabled == 1;
+}
+
+void NovaDisplay::Register(NovaDisplay* aDisplay, const void* aKey) {
+  StaticMutexAutoLock lock(sLock);
+  for (int i = 0; i < kMaxDisplays; i++) {
+    if (!sDisplays[i]) {
+      sDisplays[i] = aDisplay;
+      sKeys[i] = aKey;
+      NS_ADDREF(aDisplay);
+      return;
+    }
+  }
+}
+
+already_AddRefed<NovaDisplay> NovaDisplay::Open(HeadlessWidget* aWidget,
+                                                int32_t aWidth,
+                                                int32_t aHeight) {
+  int fd = open(kDevice, O_RDWR | O_CLOEXEC);
+  if (fd < 0) {
+    return nullptr;
+  }
+  struct {
+    uint32_t w, h;
+    char title[128];
+  } create;
+  memset(&create, 0, sizeof(create));
+  create.w = aWidth > 64 ? aWidth : 64;
+  create.h = aHeight > 64 ? aHeight : 64;
+  strncpy(create.title, "Web Browser", sizeof(create.title) - 1);
+  if (ioctl(fd, NOVA_IOCTL_CREATE, &create) != 0) {
+    close(fd);
+    return nullptr;
+  }
+  size_t size = size_t(create.w) * create.h * 4;
+  void* mapped = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  uint8_t* back = static_cast<uint8_t*>(calloc(1, size));
+  if (mapped == MAP_FAILED || !back) {
+    free(back);
+    close(fd);
+    return nullptr;
+  }
+  RefPtr<NovaDisplay> display = new NovaDisplay();
+  display->mFd = fd;
+  display->mMapped = static_cast<uint8_t*>(mapped);
+  display->mPixels = back;
+  display->mWidth = create.w;
+  display->mHeight = create.h;
+  display->mStride = create.w * 4;
+  display->mWidget = aWidget;
+  display->mKey = aWidget;
+  Register(display, aWidget);
+  NS_ADDREF(display.get());  // held by the input thread
+  display->mThread = PR_CreateThread(PR_USER_THREAD, InputLoop, display.get(),
+                                     PR_PRIORITY_NORMAL, PR_GLOBAL_THREAD,
+                                     PR_JOINABLE_THREAD, 0);
+  return display.forget();
+}
+
+already_AddRefed<NovaDisplay> NovaDisplay::AttachPopup(
+    NovaDisplay* aRoot, HeadlessWidget* aWidget, int32_t aX, int32_t aY,
+    int32_t aWidth, int32_t aHeight) {
+  if (!aRoot) {
+    return nullptr;
+  }
+  // As large as the root: a popup never needs more, and a resize then
+  // never has to move the buffer under a compositor drawing into it.
+  uint8_t* pixels = static_cast<uint8_t*>(calloc(1, size_t(aRoot->mStride) * aRoot->mHeight));
+  if (!pixels) {
+    return nullptr;
+  }
+  RefPtr<NovaDisplay> popup = new NovaDisplay();
+  popup->mRoot = aRoot;
+  popup->mPixels = pixels;
+  popup->mStride = aRoot->mStride;
+  popup->mWidth = aRoot->mWidth;
+  popup->mHeight = aRoot->mHeight;
+  popup->mX = aX;
+  popup->mY = aY;
+  popup->mW = aWidth;
+  popup->mH = aHeight;
+  popup->mWidget = aWidget;
+  popup->mKey = aWidget;
+  Register(popup, aWidget);
+  return popup.forget();
+}
+
+already_AddRefed<NovaDisplay> NovaDisplay::For(const void* aWidget) {
+  StaticMutexAutoLock lock(sLock);
+  for (int i = 0; i < kMaxDisplays; i++) {
+    if (sDisplays[i] && sKeys[i] == aWidget) {
+      RefPtr<NovaDisplay> display = sDisplays[i];
+      return display.forget();
+    }
+  }
+  return nullptr;
+}
+
+NovaDisplay::~NovaDisplay() {
+  if (mMapped) {
+    munmap(mMapped, size_t(mStride) * mHeight);
+  }
+  free(mPixels);
+  if (mFd >= 0) {
+    close(mFd);
+  }
+}
+
+int32_t NovaDisplay::Width() const {
+  return mRoot ? std::min(int32_t(mW), mWidth) : mWidth;
+}
+
+int32_t NovaDisplay::Height() const {
+  return mRoot ? std::min(int32_t(mH), mHeight) : mHeight;
+}
+
+void NovaDisplay::Compose() {
+  if (mRoot) {
+    mRoot->Compose();
+    return;
+  }
+  StaticMutexAutoLock lock(sLock);
+  memcpy(mMapped, mPixels, size_t(mStride) * mHeight);
+  for (int i = 0; i < kMaxDisplays; i++) {
+    NovaDisplay* p = sDisplays[i];
+    if (!p || p->mRoot != this) {
+      continue;
+    }
+    int32_t x0 = std::max(int32_t(p->mX), 0);
+    int32_t y0 = std::max(int32_t(p->mY), 0);
+    int32_t x1 = std::min(p->mX + p->Width(), mWidth);
+    int32_t y1 = std::min(p->mY + p->Height(), mHeight);
+    for (int32_t y = y0; y < y1; y++) {
+      const uint8_t* src = p->mPixels + size_t(y - p->mY) * p->mStride + size_t(x0 - p->mX) * 4;
+      uint8_t* dst = mMapped + size_t(y) * mStride + size_t(x0) * 4;
+      memcpy(dst, src, size_t(std::max(x1 - x0, 0)) * 4);
+    }
+  }
+  ioctl(mFd, NOVA_IOCTL_PRESENT, nullptr);
+}
+
+void NovaDisplay::Present() { Compose(); }
+
+void NovaDisplay::SetTitle(const nsAString& aTitle) {
+  if (mRoot) {
+    return;
+  }
+  char title[128];
+  memset(title, 0, sizeof(title));
+  NS_ConvertUTF16toUTF8 utf8(aTitle);
+  strncpy(title, utf8.get(), sizeof(title) - 1);
+  ioctl(mFd, NOVA_IOCTL_TITLE, title);
+}
+
+void NovaDisplay::SetCursor(uint32_t aShape) {
+  NovaDisplay* root = mRoot ? mRoot.get() : this;
+  ioctl(root->mFd, NOVA_IOCTL_CURSOR, (unsigned long)aShape);
+}
+
+void NovaDisplay::SetRect(int32_t aX, int32_t aY, int32_t aWidth,
+                          int32_t aHeight) {
+  mX = aX;
+  mY = aY;
+  mW = aWidth;
+  mH = aHeight;
+  if (mRoot) {
+    mRoot->Compose();
+  }
+}
+
+HeadlessWidget* NovaDisplay::PopupAt(int32_t aX, int32_t aY, int32_t* aLocalX,
+                                     int32_t* aLocalY) {
+  StaticMutexAutoLock lock(sLock);
+  // The most recent popup is on top: search from the end.
+  for (int i = kMaxDisplays - 1; i >= 0; i--) {
+    NovaDisplay* p = sDisplays[i];
+    if (!p || p->mRoot != this || !p->mWidget) {
+      continue;
+    }
+    if (aX >= p->mX && aY >= p->mY && aX < p->mX + p->mW && aY < p->mY + p->mH) {
+      *aLocalX = aX - p->mX;
+      *aLocalY = aY - p->mY;
+      return p->mWidget;
+    }
+  }
+  return nullptr;
+}
+
+bool NovaDisplay::HasPopups() {
+  StaticMutexAutoLock lock(sLock);
+  for (int i = 0; i < kMaxDisplays; i++) {
+    if (sDisplays[i] && sDisplays[i]->mRoot == this) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void NovaDisplay::Close() {
+  MOZ_ASSERT(NS_IsMainThread());
+  mWidget = nullptr;
+  mStop = true;
+  {
+    StaticMutexAutoLock lock(sLock);
+    for (int i = 0; i < kMaxDisplays; i++) {
+      if (sDisplays[i] == this) {
+        sDisplays[i] = nullptr;
+        sKeys[i] = nullptr;
+        Release();
+      }
+    }
+  }
+  if (mRoot) {
+    // The area the popup covered shows the window again.
+    mRoot->Compose();
+    return;
+  }
+  if (mThread) {
+    PR_JoinThread(mThread);
+    mThread = nullptr;
+  }
+}
+
+void NovaDisplay::InputLoop(void* aSelf) {
+  NovaDisplay* self = static_cast<NovaDisplay*>(aSelf);
+  PR_SetCurrentThreadName("NovaInput");
+  while (!self->mStop) {
+    struct pollfd pfd = {self->mFd, POLLIN, 0};
+    if (poll(&pfd, 1, 200) <= 0) {
+      continue;
+    }
+    NovaEvent events[16];
+    ssize_t n = read(self->mFd, events, sizeof(events));
+    if (n <= 0) {
+      continue;
+    }
+    for (ssize_t i = 0; i < n / ssize_t(sizeof(NovaEvent)); i++) {
+      NovaEvent event = events[i];
+      RefPtr<NovaDisplay> display = self;
+      NS_DispatchToMainThread(NS_NewRunnableFunction(
+          "NovaDisplay::Deliver",
+          [display, event]() { display->Deliver(event); }));
+    }
+  }
+  self->Release();
+}
+
+void NovaDisplay::Deliver(const NovaEvent& aEvent) {
+  if (mWidget) {
+    RefPtr<HeadlessWidget> widget = mWidget;
+    widget->HandleNovaEvent(aEvent);
+  }
+}
+
+}  // namespace widget
+}  // namespace mozilla
