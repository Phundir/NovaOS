+    {0x4D, NS_VK_RIGHT, KEY_NAME_INDEX_ArrowRight},
+    {0x4F, NS_VK_END, KEY_NAME_INDEX_End},
+    {0x50, NS_VK_DOWN, KEY_NAME_INDEX_ArrowDown},
+    {0x51, NS_VK_PAGE_DOWN, KEY_NAME_INDEX_PageDown},
+    {0x52, NS_VK_INSERT, KEY_NAME_INDEX_Insert},
+    {0x53, NS_VK_DELETE, KEY_NAME_INDEX_Delete},
+};
+
+Modifiers NovaModifiers(uint32_t aBits) {
+  Modifiers m = 0;
+  if (aBits & 1) m |= MODIFIER_SHIFT;
+  if (aBits & 2) m |= MODIFIER_CONTROL;
+  if (aBits & 4) m |= MODIFIER_ALT;
+  if (aBits & 8) m |= MODIFIER_META;
+  return m;
+}
+
+}  // namespace
+
+TextEventDispatcherListener*
+HeadlessWidget::GetNativeTextEventDispatcherListener() {
+  if (!mNova) {
+    return nsBaseWidget::GetNativeTextEventDispatcherListener();
+  }
+  if (!mNovaKeys) {
+    mNovaKeys = new NovaKeyListener();
+  }
+  return mNovaKeys;
+}
+
+void HeadlessWidget::DispatchNovaKey(const NovaEvent& aEvent) {
+  bool down = aEvent.type == NOVA_EV_KEY_DOWN;
+  uint32_t keyCode = 0;
+  KeyNameIndex name = KEY_NAME_INDEX_USE_STRING;
+  char16_t ch = 0;
+  // Ctrl and Alt combinations still carry their letter: Gecko's
+  // shortcuts (Ctrl+L, Ctrl+T) look at the key value.
+  if (aEvent.character >= 0x20 && aEvent.character < 0xD800 &&
+      aEvent.character != 0x7F) {
+    ch = char16_t(aEvent.character);
+    keyCode = WidgetUtils::ComputeKeyCodeFromChar(ch);
+  } else {
+    for (const NovaKey& k : kNovaKeys) {
+      if (k.scancode == aEvent.code) {
+        keyCode = k.keyCode;
+        name = k.name;
+        break;
+      }
+    }
+    if (aEvent.character == 0x0A) {
+      keyCode = NS_VK_RETURN;
+      name = KEY_NAME_INDEX_Enter;
+    } else if (aEvent.character == 0x09) {
+      keyCode = NS_VK_TAB;
+      name = KEY_NAME_INDEX_Tab;
+    }
+    if (!keyCode) {
+      return;
+    }
+  }
+  RefPtr<TextEventDispatcher> dispatcher = GetTextEventDispatcher();
+  if (NS_FAILED(dispatcher->BeginNativeInputTransaction())) {
+    return;
+  }
+  WidgetKeyboardEvent event(true, down ? eKeyDown : eKeyUp, this);
+  event.mKeyCode = keyCode;
+  event.mKeyNameIndex = name;
+  if (name == KEY_NAME_INDEX_USE_STRING) {
+    event.mKeyValue = ch;
+  }
+  event.mCodeNameIndex = CODE_NAME_INDEX_UNKNOWN;
+  event.mModifiers = NovaModifiers(aEvent.modifiers);
+  event.mLocation = eKeyLocationStandard;
+  event.mTimeStamp = TimeStamp::Now();
+  nsEventStatus status = nsEventStatus_eIgnore;
+  if (!dispatcher->DispatchKeyboardEvent(event.mMessage, event, status) ||
+      !down || mDestroyed || status == nsEventStatus_eConsumeNoDefault) {
+    return;
+  }
+  WidgetKeyboardEvent press(true, eKeyPress, this);
+  press.AssignKeyEventData(event, false);
+  dispatcher->MaybeDispatchKeypressEvents(press, status);
+}
+
+void HeadlessWidget::HandleNovaPopupEvent(const NovaEvent& aEvent,
+                                          LayoutDeviceIntPoint aScreen) {
+  if (mDestroyed) {
+    return;
+  }
+  switch (aEvent.type) {
+    case NOVA_EV_MOTION:
+      SynthesizeNativeMouseEvent(aScreen, NativeMouseMessage::Move,
+                                 MouseButton::eNotPressed,
+                                 nsIWidget::Modifiers::NO_MODIFIERS, nullptr);
+      break;
+    case NOVA_EV_BUTTON_DOWN:
+    case NOVA_EV_BUTTON_UP:
+      SynthesizeNativeMouseEvent(aScreen,
+                                 aEvent.type == NOVA_EV_BUTTON_DOWN
+                                     ? NativeMouseMessage::ButtonDown
+                                     : NativeMouseMessage::ButtonUp,
+                                 MouseButton::ePrimary,
+                                 nsIWidget::Modifiers::NO_MODIFIERS, nullptr);
+      break;
+    case NOVA_EV_WHEEL:
+      SynthesizeNativeMouseScrollEvent(aScreen, 0, 0, double(aEvent.value), 0,
+                                       0, 0, nullptr);
+      break;
+    default:
+      break;
+  }
+}
+
+void HeadlessWidget::HandleNovaEvent(const NovaEvent& aEvent) {
+  if (mDestroyed) {
+    return;
+  }
+  LayoutDeviceIntPoint point(aEvent.x, aEvent.y);
+  point += WidgetToScreenOffset();
+  bool mouse = aEvent.type == NOVA_EV_MOTION ||
+               aEvent.type == NOVA_EV_BUTTON_DOWN ||
+               aEvent.type == NOVA_EV_BUTTON_UP || aEvent.type == NOVA_EV_WHEEL;
+  if (mouse && mNova) {
+    // A popup under the pointer takes the mouse; its own widget turns
+    // the screen point back into its coordinates.
+    int32_t lx, ly;
+    if (RefPtr<HeadlessWidget> popup = mNova->PopupAt(aEvent.x, aEvent.y, &lx, &ly)) {
+      NovaEvent local = aEvent;
+      popup->HandleNovaPopupEvent(local, point);
+      return;
+    }
+    // A press outside every popup closes them, as a window manager would.
+    if (aEvent.type == NOVA_EV_BUTTON_DOWN && mNova->HasPopups()) {
+      if (nsIRollupListener* rollup = nsBaseWidget::GetActiveRollupListener()) {
+        nsIRollupListener::RollupOptions options;
+        options.mFlush = nsIRollupListener::FlushViews::Yes;
+        options.mPoint = &point;
+        if (rollup->Rollup(options)) {
+          return;
+        }
+      }
+    }
+  }
+  switch (aEvent.type) {
+    case NOVA_EV_MOTION:
+      SynthesizeNativeMouseEvent(point, NativeMouseMessage::Move,
+                                 MouseButton::eNotPressed,
+                                 nsIWidget::Modifiers::NO_MODIFIERS, nullptr);
+      break;
+    case NOVA_EV_BUTTON_DOWN:
+    case NOVA_EV_BUTTON_UP:
+      SynthesizeNativeMouseEvent(point,
+                                 aEvent.type == NOVA_EV_BUTTON_DOWN
+                                     ? NativeMouseMessage::ButtonDown
+                                     : NativeMouseMessage::ButtonUp,
+                                 MouseButton::ePrimary,
+                                 nsIWidget::Modifiers::NO_MODIFIERS, nullptr);
+      break;
+    case NOVA_EV_WHEEL:
+      // A notch away from the user scrolls up: three lines, as on GTK.
+      SynthesizeNativeMouseScrollEvent(point, 0, 0, double(aEvent.value), 0,
+                                       0, 0, nullptr);
+      break;
+    case NOVA_EV_KEY_DOWN:
+    case NOVA_EV_KEY_UP:
+      DispatchNovaKey(aEvent);
+      break;
+    case NOVA_EV_RESIZE:
+      ResizeInternal(aEvent.x, aEvent.y, true);
+      break;
+    case NOVA_EV_CLOSE:
+      if (mWidgetListener) {
+        mWidgetListener->RequestWindowClose(this);
+      }
+      break;
+    default:
+      break;
+  }
+}
