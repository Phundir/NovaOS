@@ -0,0 +1,132 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/*
+ * NovaDisplay: shows a headless top-level window on Nova OS.
+ *
+ * Nova OS runs this browser through its Linux subsystem and gives it one
+ * device, /dev/nova-gui: a window of the Nova compositor whose pixels are
+ * a BGRA buffer the process maps, and whose input comes back as 32-byte
+ * records read from the descriptor. The headless widget already does
+ * everything else a window needs; with NOVA_DISPLAY=1 in the environment
+ * each top-level headless widget opens such a window, its compositor
+ * renders into the mapped buffer (StartRemoteDrawingInRegion), and a
+ * thread turns the records into Gecko input events on the main thread.
+ */
+
+#ifndef widget_headless_NovaDisplay_h
+#define widget_headless_NovaDisplay_h
+
+#include "mozilla/RefPtr.h"
+#include "mozilla/Atomics.h"
+#include "nsISupportsImpl.h"
+#include "nsString.h"
+#include "prthread.h"
+
+namespace mozilla {
+namespace widget {
+
+class HeadlessWidget;
+
+struct NovaEvent {
+  uint32_t type;
+  int32_t x;
+  int32_t y;
+  uint32_t code;
+  uint32_t modifiers;
+  uint32_t character;
+  int32_t value;
+  uint32_t reserved;
+};
+
+enum : uint32_t {
+  NOVA_EV_MOTION = 1,
+  NOVA_EV_BUTTON_DOWN = 2,
+  NOVA_EV_BUTTON_UP = 3,
+  NOVA_EV_WHEEL = 4,
+  NOVA_EV_KEY_DOWN = 5,
+  NOVA_EV_KEY_UP = 6,
+  NOVA_EV_RESIZE = 7,
+  NOVA_EV_CLOSE = 8,
+  NOVA_EV_FOCUS = 9,
+};
+
+class NovaDisplay final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(NovaDisplay)
+
+  // NOVA_DISPLAY=1 and the device exists.
+  static bool Enabled();
+
+  // Opens a window of aWidth x aHeight for a top-level aWidget (main
+  // thread).
+  static already_AddRefed<NovaDisplay> Open(HeadlessWidget* aWidget,
+                                            int32_t aWidth, int32_t aHeight);
+
+  // A popup of the window aRoot: a menu, a list, a tooltip. It has no
+  // window of its own; its pixels are laid over the root's at aX, aY.
+  static already_AddRefed<NovaDisplay> AttachPopup(NovaDisplay* aRoot,
+                                                   HeadlessWidget* aWidget,
+                                                   int32_t aX, int32_t aY,
+                                                   int32_t aWidth,
+                                                   int32_t aHeight);
+
+  // The display of a widget, from any thread (the compositor's).
+  static already_AddRefed<NovaDisplay> For(const void* aWidget);
+
+  // Where the compositor of this widget draws.
+  uint8_t* Pixels() const { return mPixels; }
+  int32_t Width() const;
+  int32_t Height() const;
+  int32_t Stride() const { return mStride; }
+
+  // The widget's frame is complete: compose and show.
+  void Present();
+  void SetTitle(const nsAString& aTitle);
+  void SetCursor(uint32_t aShape);
+  // Popups: new position or size, relative to the root window.
+  void SetRect(int32_t aX, int32_t aY, int32_t aWidth, int32_t aHeight);
+  // The popup under a point of the root window, if any (main thread).
+  HeadlessWidget* PopupAt(int32_t aX, int32_t aY, int32_t* aLocalX,
+                          int32_t* aLocalY);
+  bool HasPopups();
+  // Stops the input thread and closes the window, or detaches a popup
+  // (main thread).
+  void Close();
+
+ private:
+  NovaDisplay() = default;
+  ~NovaDisplay();
+
+  static void InputLoop(void* aSelf);
+  void Deliver(const NovaEvent& aEvent);
+  void Compose();
+  static void Register(NovaDisplay* aDisplay, const void* aKey);
+
+  // Root window only.
+  int mFd = -1;
+  uint8_t* mMapped = nullptr;  // what the compositor of Nova shows
+  PRThread* mThread = nullptr;
+  Atomic<bool> mStop{false};
+
+  // Both: the buffer this widget's compositor draws into. For the root,
+  // a back buffer composed onto mMapped with the popups at each present.
+  uint8_t* mPixels = nullptr;
+  int32_t mStride = 0;
+  int32_t mWidth = 0;
+  int32_t mHeight = 0;
+
+  // Popups only.
+  RefPtr<NovaDisplay> mRoot;
+  Atomic<int32_t> mX{0}, mY{0}, mW{0}, mH{0};
+
+  const void* mKey = nullptr;
+  HeadlessWidget* mWidget = nullptr;  // main thread only, cleared by Close
+};
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif
